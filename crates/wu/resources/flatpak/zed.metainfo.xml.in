<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>MIT</metadata_license>
    <project_license>Apache-2.0 and GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>The AI engineering workspace</summary>
    <developer id="com.workspaacing">
        <name translate="no">Workspaacing</name>
    </developer>
    <description>
        <p>
            Anna plans, codes, tests and ships — natively, on your machine. It is a native code editor with an AI agent teammate inside it, also called Anna, built on the Zed engine: the editor core, GPU rendering, and language tooling.
        </p>
        <p>Features:</p>
        <ul>
            <li>Agent: Reads, writes and edits files through the editor's buffers, runs shell commands at the permission level you choose, fetches web pages, and works with GitHub issues, pull requests, checks and security alerts.</li>
            <li>Checked edits: Refuses to write credentials, formats with the project's own formatter, reads language server diagnostics, and checks edited dependencies against the OSV advisory database.</li>
            <li>Your models: Any model in the models.dev catalog, using your own provider keys, with no account and no proxy.</li>
            <li>Performance: Written in Rust and rendered on the GPU. No Electron or webviews. Opens instantly and stays responsive on large files.</li>
            <li>Language-aware: Maintains a syntax tree for precise highlighting and auto-indent, with LSP support for autocompletion and refactoring.</li>
            <li>Lightweight: Uses noticeably less memory than comparable editors.</li>
            <li>Familiar: Layout, panels, and defaults are tuned so VS Code users don't have to relearn their editor.</li>
        </ul>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="homepage">https://wu.farshed.me</url>
    <url type="bugtracker">https://github.com/Workspaacing/anna/issues</url>
    <url type="help">https://wu.farshed.me/docs</url>
    <url type="contact">https://github.com/Workspaacing/anna/issues</url>
    <url type="vcs-browser">https://github.com/Workspaacing/anna</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>

    <screenshots>
        <screenshot type="default">
            <caption>Anna with a project open, in the Catppuccin Mocha theme</caption>
            <image>https://raw.githubusercontent.com/Workspaacing/anna/main/assets/images/screenshot-dark.png</image>
        </screenshot>
        <screenshot>
            <caption>Anna with a project open, in the Catppuccin Latte theme</caption>
            <image>https://raw.githubusercontent.com/Workspaacing/anna/main/assets/images/screenshot-light.png</image>
        </screenshot>
    </screenshots>

    <releases>
		@release_info@
		<release version="0.0.0" date="1970-01-01">
			<description>
				<p>Dummy release to keep flatpak-builder AppStream metadata validation from complaining</p>
			</description>
		</release>
    </releases>
</component>
