name: anna
title: Anna
base: core24
version: "$RELEASE_VERSION"
summary: The AI engineering workspace.
description: |
  Anna plans, codes, tests and ships — natively, on your machine. It is a
  native code editor built in Rust with a GPU-accelerated renderer, with an
  AI agent teammate inside it that edits files, runs commands at the
  permission level you choose, and works with GitHub.
grade: stable
confinement: classic
compression: lzo
website: https://wu.farshed.me/
source-code: https://github.com/Workspaacing/anna
issues: https://github.com/Workspaacing/anna/issues
contact: https://github.com/Workspaacing/anna/issues

parts:
  anna:
    plugin: dump
    source: "https://github.com/Workspaacing/anna/releases/download/v$RELEASE_VERSION/anna-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Anna exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Anna exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  anna:
    command: usr/bin/anna
    common-id: com.workspaacing.Anna
    environment:
      ZED_BUNDLE_TYPE: snap
